# Compiled / packaged output — source code stays in the private kaBluey repo
*.exe
*.msix
*.appx
*.appxbundle
*.zip
*.whl

# Python source and build artefacts
*.py
*.pyc
*.pyd
__pycache__/
*.spec
build/
dist/

# Packaging temp files and secrets
packaging/PackageLayout/
packaging/*.pfx
packaging/*.msix

# MSIX binaries are published as GitHub Release assets, not committed to the repo.
# (The previous "!releases/**/*.msix" negation put ~150 MB of packages into history.)
# Signed manifests (releases/*/SHA256SUMS.txt[.asc]) DO stay tracked for Rule 2 verification.

# Local-only archive of superseded builds — kept on this machine, never pushed
archive/

# IDE and OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Legacy program versions kept locally only (not replicated)
/archive/
/Archive/
